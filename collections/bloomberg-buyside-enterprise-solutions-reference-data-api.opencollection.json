{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bloomberg Buyside Enterprise Solutions Bloomberg Analytics Allocations Reference Data API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Reference Data",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Bloomberg Buyside Enterprise Solutions Get reference data for securities",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.bloomberg.com/analytics/data/v1/reference",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Retrieve reference data fields for one or more securities. Returns static or slowly changing descriptive data such as identifiers, classifications, issue details, and corporate information."
        },
        {
          "info": {
            "name": "Bloomberg Buyside Enterprise Solutions Search for securities",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bloomberg.com/analytics/data/v1/securities/search",
            "params": [
              {
                "name": "query",
                "value": "",
                "type": "query",
                "description": "Security name, ticker, or identifier to search for"
              },
              {
                "name": "assetClass",
                "value": "",
                "type": "query",
                "description": "Filter by asset class"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of results"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of results to skip"
              }
            ]
          },
          "docs": "Search for securities by name, ticker, ISIN, CUSIP, or other identifiers. Returns matching securities with key reference fields."
        }
      ]
    }
  ],
  "bundled": true
}